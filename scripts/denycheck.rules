# Rules for scripts/denycheck.py. Edit this file here, by pull request.
# Patterns are shown as they are. A name is shown only as the SHA-256 of its
# lower-case form; the script hashes every token of every file and compares.
# To add a name without typing it into the repository, run
#   python3 scripts/denycheck.py --hash WORD
# and add the line that it prints.
re fpl-number \bFPL\s*\d+
re fcr-number \bFCR\s*\d+
re review-id \bR\d+-[A-Z0-9]+(?:-[A-Z0-9]+)?\b
re rule-number \brule\s+\d+\.\d+
re section-item \b\d+\.\d+(?:,\s*\d+\.\d+)*\s+items?\s+\d+
re spec-section \b(?:policy-semantics|section\s+12\.\d+)
re review-round \b(?:review\s+)?round\s+\d+|\breview\s+(?:lead\s+)?ruling\b|\blead\s+ruling\b|\bruling\s+(?:item\s+)?\d+
re work-item-id (?:^|[^\\A-Za-z0-9])(?:rb\d[a-z]?|f\d{2}[a-z]|x\d{2})\b
re design-ref \bthreat\s+model\b|\b(?:fix\s+)?cycle\s+\d+[A-Z]?\b|\bfindings?\s+F\d+\b|\bF\d\.|\bitem\s+[A-Z]\b|\bTask\s+[A-Z]\b|\bA\.8\.\d+\b|\bcontract\s+C\d\b
re isms \bISMS\b|\bISO\s?27001\b|\bSOC\s?2\b
re internal-doc \bdocs/(?:runbooks|work|isms)/
re email [A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}\b
re runos-host \b[a-z0-9-]+(?:\.[a-z0-9-]+)*\.runos\.(?:com|dev)\b
re environment \brunos-(?:prod|beta|dev)\b|\b(?:in|on|for)\s+(?:the\s+)?prod(?:uction)?\b|\bprod(?:uction)?\s+(?:root|cluster|environment|namespace|deployment)\b|\bstaging\b
re operator-decision \boperator(?:'s)?\s+(?:ruling|decision|call|rule)\b
re iso-date \b20\d\d-\d\d-\d\d\b
re key-custody (?:^|[^.A-Za-z0-9])(?:AWS|KMS|PKCS\s?#?11|YubiKeys?|HSMs?|Object\s+Lock|SoftHSM)\b
re test-id \bAT-[A-Z0-9]+-\d+\b|\bSIG-?\d+\b|\bR20\b
re internal-path \bproto/|\bscripts/up\.sh|\brun/runos\b|README\.md|\bsigner/(?:jobgrant|intake|receipt|checkpoint|cmd|pkcs11)\b|\brootceremony\b|\bdesign\s+(?:record|sections?|\d)|\bsections?\s+\d+(?:\.\d+)*\b
re test-name-id \bTest(?:AT_|Rule\d+_|Review\d|[FX]\d{1,2}[a-z]?[A-Z_])
re note-id \bN-M\d+\b
re section-number (?:^|[^.0-9])12\.\d\d(?:$|[^.0-9]|\.(?:$|[^0-9]))
path file-name-id (?:^|/)(?:f\d+[a-z]?|review\d+|x\d\d|rb\d[a-z]?|item\d+)(?:_[^/]*)?\.go$
allow security@runos\.com
allow [A-Za-z0-9._%+-]+@example\.(?:com|org|net)
